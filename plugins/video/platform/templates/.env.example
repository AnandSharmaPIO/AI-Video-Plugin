# Copy to .env and fill in real values. NEVER commit .env.
# Generic credential slots for the walkthrough recorder — any app, any stack.
WALKTHROUGH_EMAIL=demo@example.com
WALKTHROUGH_PASSWORD=change-me

# Optional: per-environment credentials. If a project.yaml environment sets its
# own `credentialsEnv` (e.g. a local build with a seeded-DB account distinct from
# the live one), add those vars here. Names must match the yaml; values stay here.
# WALKTHROUGH_LOCAL_EMAIL=local-admin@example.com
# WALKTHROUGH_LOCAL_PASSWORD=change-me
