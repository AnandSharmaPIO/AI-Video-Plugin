import { test, expect, type Page } from '@playwright/test';
import { installCursor, resetCursor, glideTo, moveAndClick } from '@engine/cursor';
import {
  beat,
  loadEnvChain,
  requiredEnv,
  ShotTimer,
  promoteRecording,
} from '@engine/walkthrough';

/**
 * ─────────────────────────────────────────────────────────────────────────────
 *  FEATURE WALKTHROUGH — fill in the TODO(shot) regions below.
 *  Lives in: <p>/modules/<m>/features/<f>/walkthrough.spec.ts
 *  Record:   npm run record -- <p>/modules/<m>/features/<f>
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *  ROBUSTNESS RULES (learned the hard way — follow them):
 *   1. Prefer role / text / placeholder / label locators over brittle CSS class
 *      selectors. Classes change; accessible names and visible text don't.
 *   2. Wait on the NETWORK or DOM for correctness — never a fixed sleep to "let
 *      it load". Use `page.waitForResponse(...)` or `expect(...).toBeVisible()`.
 *      Use `beat()` ONLY for cosmetic pacing (letting a shot linger for narration).
 *   3. GUARD every data-dependent shot with `if (await locator.count())` and
 *      `console.log` a skip message — a missing element must not fail the run.
 *      Call `timer.mark(N)` INSIDE the guard so a skipped shot is never marked.
 *   4. Glide BEFORE typing or clicking: `glideTo` then act; `moveAndClick` for
 *      clicks. When a click fires a request you must await, put moveAndClick in
 *      a Promise.all with the waitForResponse and pass `{ durationMs: 0 }`.
 *   5. Re-assert the cursor after every full-page navigation: `installCursor(page)`.
 *
 *  Each shot: `timer.mark(N)` → glide/act → assert new state → `beat()` to hold
 *  for narration. Keep shot numbers/titles aligned with feature.yaml + narration.md.
 *  Optional: `await snap(page, FEATURE_DIR, 'shot-02-slug')` saves a PNG still
 *  to generated/frames/ — free training-doc screenshots from the same run.
 */

const FEATURE_DIR = process.env.WT_FEATURE_DIR!;

/* Credentials come from .env files (feature → project → repo root) — never
 * hardcode secrets here. Delete if the feature needs no auth. */
loadEnvChain(FEATURE_DIR);
const EMAIL = requiredEnv('WALKTHROUGH_EMAIL');
const PASSWORD = requiredEnv('WALKTHROUGH_PASSWORD');

const timer = new ShotTimer();

test('feature walkthrough', async ({ page }) => {
  test.setTimeout(5 * 60 * 1000);
  resetCursor();

  /* ══ Shot 1: Login ══════════════════════════════════════════════════
   * TODO(shot): adjust route/selectors; delete the block if no auth.      */
  timer.start(); // t0 ≈ first frame of the recording
  timer.mark(1);
  await page.goto('/login');
  await installCursor(page);
  await beat(page, 1000);

  const emailField = page.getByLabel(/email/i);
  await glideTo(page, emailField);
  await emailField.click();
  await emailField.pressSequentially(EMAIL, { delay: 55 });

  const passwordField = page.getByLabel(/password/i);
  await glideTo(page, passwordField);
  await passwordField.click();
  await passwordField.pressSequentially(PASSWORD, { delay: 55 });
  await beat(page, 400);

  await moveAndClick(page, page.getByRole('button', { name: /sign in|log in/i }));
  // TODO(shot): wait for the post-login landing route/state.
  await page.waitForURL('**/**', { timeout: 30_000 });
  await installCursor(page);
  await beat(page, 1600);

  /* ══ Shot 2: Navigate to the feature ════════════════════════════════
   * TODO(shot): click the nav item / link that opens your feature.       */
  // timer.mark(2);
  // await moveAndClick(page, page.getByRole('link', { name: 'My Feature' }));
  // await page.waitForURL('**/my-feature');
  // await installCursor(page);
  // await expect(page.getByRole('heading', { name: 'My Feature' })).toBeVisible();
  // await beat(page, 2200);

  /* ══ Shot 3+: The feature's core interactions ═══════════════════════
   * TODO(shot): see the robustness rules above; guard optional shots.    */

  /* ══ Final shot: Wrap ═══════════════════════════════════════════════
   * TODO(shot): settle on a clean final frame; renumber to your last.    */
  timer.mark(2); // TODO(shot): set to your final shot number
  await glideTo(page, page.locator('body'), 800);
  await beat(page, 2000);

  timer.save(FEATURE_DIR);
});

test.afterAll(async () => {
  promoteRecording(FEATURE_DIR);
});
