{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@engine/*": [
        "platform/engine/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/generated/**",
    "platform/tts/venv"
  ]
}
